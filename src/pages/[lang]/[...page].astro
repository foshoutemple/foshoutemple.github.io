---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import EventRows from '../../components/EventRows.astro';
import Schedule from '../../components/Schedule.astro';
import Calendar from '../../components/Calendar.astro';
import TempleUpdates from '../../components/TempleUpdates.astro';
import ActivityCalendar from '../../components/ActivityCalendar.astro';
import AnnouncementDetail from '../../components/AnnouncementDetail.astro';
import {copy,calendar,site,languages,link,asset,dateText,getUpcoming} from '../../lib/temple.js';
import {publishedEvents,publishedNews} from '../../lib/event-content.js';
import {nextSundayDate} from '../../lib/live-dates.js';

const customEvents=publishedEvents(import.meta.glob('../../../content/events/*.md',{eager:true}));
const news=publishedNews(import.meta.glob('../../../content/news/*.md',{eager:true}));
export function getStaticPaths(){
 const custom=publishedEvents(import.meta.glob('../../../content/events/*.md',{eager:true}));
 const news=publishedNews(import.meta.glob('../../../content/news/*.md',{eager:true}));
 const pages=[undefined,'about','services','services/sunday','offerings','visit','calendar','news',...calendar.events.map(e=>`calendar/${e.id}`),...custom.map(e=>`services/${e.slug}`),...news.map(e=>`news/${e.slug}`)];
 return languages.flatMap(lang=>pages.map(page=>({params:{lang,page}})));
}
const {lang,page:route}=Astro.params;const page=route || '';const t=copy[lang];
const event=page.startsWith('calendar/')?calendar.events.find(e=>`calendar/${e.id}`===page):null;
const customEvent=page.startsWith('services/')?customEvents.find(e=>`services/${e.slug}`===page):null;
const newsItem=page.startsWith('news/')?news.find(e=>`news/${e.slug}`===page):null;
const pageKey=page.split('/')[0];
const title=event?event.title[lang]:customEvent?customEvent.title[lang]:newsItem?newsItem.title[lang]:page==='news'?t.updates.newsTitle:page?t[pageKey]?.title:undefined;
const upcoming=getUpcoming(3);
const pendingTime=t.activityCalendar.pendingTime;
const fullCalendar=lang==='en'?'View the full calendar':lang==='zh-hans'?'查看全年日历':'查看全年日曆';
const nextText=lang==='en'?'Next observances':lang==='zh-hans'?'近期佛教纪念日':'近期佛教紀念日';
const sundayDate=nextSundayDate();
const servicePhoto=page==='services/sunday'
 ? {file:'altar-gathering.jpg',...t.photos.altarGathering}
 : {file:'indoor-practice.jpg',...t.photos.practice};
---
<Layout lang={lang} page={page} title={title}>
{page==='' && <>
  <section class="hero container">
    <div class="hero-title"><h1>{t.home.title.split('\n').map(line=><span>{line}</span>)}</h1></div>
    <div class="hero-copy"><p>{t.home.intro}</p><div class="button-row"><a class="button primary" href={link(lang,'services')}>{t.common.viewSchedule}<Icon/></a><a class="text-link" href={link(lang,'visit')}>{t.common.directions}<Icon name="external" size={17}/></a></div><div class="hero-location"><Icon name="pin" size={17}/><span>1015 Cherry Street · Philadelphia</span></div></div>
    <figure class="hero-image"><img src={asset('images/shared-practice.jpg')} width="1280" height="960" alt={t.common.heroAlt} fetchpriority="high"/><figcaption><span>{t.common.photoCaption}</span><span aria-hidden="true">Fo Shou Temple</span></figcaption></figure>
  </section>
  <div class="welcome-strip"><div class="container"><span><Icon name="clock"/>{t.common.openDaily}</span><span>{t.common.noRegistration}</span><span>{t.common.mandarin}</span><a href={link(lang,'calendar')}><Icon name="calendar"/>{t.nav.calendar}<Icon size={16}/></a></div></div>
  <TempleUpdates lang={lang} news={news} events={customEvents} preview/>
  <section class="container section weekly-section">
    <div class="section-intro"><h2>{t.home.weeklyTitle}</h2><p>{t.home.weeklyIntro}</p><a class="text-link" href={link(lang,'services/sunday')}>{t.common.details}<Icon/></a></div>
    <div><div class="schedule-label"><span>{t.services.regularLabel}</span><time class="schedule-date" datetime={sundayDate} data-next-sunday data-lang={lang}>{dateText(sundayDate,lang,{month:'long',day:'numeric'})}</time></div><Schedule lang={lang}/></div>
  </section>
  <section class="calendar-band"><div class="container section calendar-preview">
    <div class="section-intro"><h2>{t.home.calendarTitle}</h2><p>{t.home.calendarIntro}</p><a class="text-link" href={link(lang,'calendar')}>{fullCalendar}<Icon/></a></div>
    <div><div class="schedule-label"><span>{nextText}</span><Icon name="calendar"/></div><EventRows lang={lang} events={upcoming}/></div>
  </div></section>
  <section class="container section about-preview"><figure><img src={asset('images/temple-entrance.jpg')} width="1280" height="959" loading="lazy" alt={t.common.entranceAlt}/><figcaption>1015 Cherry Street, Philadelphia</figcaption></figure><div class="section-intro"><h2>{t.home.aboutTitle}</h2><p>{t.home.aboutText}</p><a class="text-link" href={link(lang,'about')}>{t.common.learnMore}<Icon/></a></div></section>
  <section class="meal-band"><div class="container meal-preview"><div><h2>{t.home.offeringsTitle}</h2><p>{t.home.offeringsText}</p></div><a class="button light" href={link(lang,'offerings')}>{t.nav.offerings}<Icon/></a></div></section>
  <section class="container section visit-preview"><h2>{t.home.visitTitle}</h2><div><p class="address-display">{site.address}<br/>{site.cityLine}</p><p>{t.common.openDaily}</p></div><div><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">{t.common.directions}<Icon name="external"/></a><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a></div></section>
</>}

{page==='about' && <>
 <section class="container page-heading"><h1>{t.about.title}</h1><p>{t.about.intro}</p></section>
 <section class="container about-feature"><figure><img src={asset('images/temple-entrance.jpg')} width="1280" height="959" alt={t.common.entranceAlt}/><figcaption>1015 Cherry Street · Philadelphia</figcaption></figure><div class="prose"><p class="large-copy">{t.about.body}</p><h2>{t.about.practiceTitle}</h2><p>{t.about.practiceText}</p><a class="text-link" href={link(lang,'services')}>{t.common.viewSchedule}<Icon/></a></div></section>
 <section class="container section story-row"><div><h2>{t.about.welcomeTitle}</h2><p>{t.about.welcomeText}</p><a class="button primary" href={link(lang,'visit')}>{t.nav.visit}<Icon/></a></div><figure><img src={asset('images/temple-community.jpg')} width="1706" height="1279" alt={t.photos.community.alt} loading="lazy"/><figcaption>{t.photos.community.caption}</figcaption></figure></section>
</>}

{(page==='services'||page==='services/sunday') && <>
 <section class="container page-heading"><h1>{page==='services/sunday'?t.home.weeklyTitle:t.services.title}</h1><p>{t.services.intro}</p><div class="inline-facts"><span>{t.common.noRegistration}</span><span>{t.common.mandarin}</span><span>{t.common.freeMeal}</span></div></section>
 {page==='services' && <TempleUpdates lang={lang} events={customEvents} assembliesOnly/>}
 {page==='services' && <ActivityCalendar lang={lang} events={customEvents}/>}
 <section class="container service-main"><div class="service-photo"><img src={asset(`images/${servicePhoto.file}`)} width="1706" height="1279" alt={servicePhoto.alt}/><p>{servicePhoto.caption}</p></div><div><h2>{t.services.regularLabel}</h2><Schedule lang={lang}/><p class="small-note">{t.services.noticeText}</p></div></section>
 <section class="calendar-band"><div class="container section calendar-preview"><div class="section-intro"><h2>{t.services.specialTitle}</h2><p>{t.services.specialText}</p><a class="text-link" href={link(lang,'calendar')}>{fullCalendar}<Icon/></a></div><EventRows lang={lang} events={upcoming}/></div></section>
</>}

{page==='offerings' && <>
 <section class="container page-heading"><h1>{t.offerings.title}</h1><p>{t.offerings.intro}</p></section>
 <section class="container offerings-main"><div class="offerings-copy"><article><h2>{t.offerings.offeringTitle}</h2><p>{t.offerings.offeringText}</p></article><article><h2>{t.offerings.mealTitle}</h2><p>{t.offerings.mealText}</p></article><div class="offering-invitation"><p>{t.offerings.invitation}</p><a class="text-link" href={link(lang,'visit')}>{t.nav.visit}<Icon/></a></div></div><figure><img src={asset('images/altar-offerings.jpg')} width="1280" height="960" alt={t.photos.offerings.alt}/><figcaption>{t.photos.offerings.caption}</figcaption></figure></section>
 <section class="container section compact-close"><h2>{t.home.weeklyTitle}</h2><p>{t.home.weeklyIntro}</p><a class="button primary" href={link(lang,'services')}>{t.common.viewSchedule}<Icon/></a></section>
</>}

{page==='visit' && <>
 <section class="container page-heading"><h1>{t.visit.title}</h1><p>{t.visit.intro}</p></section>
 <section class="container visit-main"><div class="contact-details"><div><Icon name="pin"/><div><h2>{t.visit.addressLabel}</h2><p class="address-display">{site.address}<br/>{site.cityLine}</p><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">{t.common.directions}<Icon name="external"/></a></div></div><div><Icon name="clock"/><div><h2>{t.visit.hoursLabel}</h2><p>{t.visit.hoursValue}</p><p class="muted">{t.common.noRegistration}</p></div></div><div><Icon name="mail"/><div><h2>{t.visit.emailLabel}</h2><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a></div></div></div><figure><img src={asset('images/temple-entrance.jpg')} width="1280" height="959" alt={t.common.entranceAlt}/><figcaption>{t.common.entranceAlt}</figcaption></figure></section>
 <section class="container section faq-section"><div class="section-intro"><h2>{t.visit.firstVisitTitle}</h2><p>{t.visit.firstVisitText}</p><a class="text-link" href={link(lang,'services')}>{t.common.viewSchedule}<Icon/></a></div><div class="faq-list">{t.visit.faq.map(item=><details><summary>{item.q}<Icon name="plus"/></summary><p>{item.a}</p></details>)}</div></section>
</>}

{page==='calendar' && <>
 <section class="container page-heading calendar-page-heading"><h1>{t.calendar.title}</h1><p>{t.calendar.intro}</p></section>
 <div class="container calendar-page"><Calendar lang={lang}/><details class="calendar-sources"><summary>{t.calendar.sourceLabel}</summary><ul>{calendar.sources.map((source,i)=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{lang==='en'&&i===0?'Hong Kong Buddhist Association · Buddhist holy days':lang==='en'&&i===1?'Hong Kong Buddhist Association · Ullambana':source.title}<Icon name="external" size={14}/></a></li>)}</ul></details></div>
</>}

{page==='news' && <TempleUpdates lang={lang} news={news} events={customEvents} pageHeading/>}

{event && <>
 <section class="container page-heading event-heading"><a class="back-link" href={link(lang,'calendar')}><Icon name="left" size={16}/>{t.calendar.backCalendar}</a><h1>{event.title[lang]}</h1><p>{dateText(event.date,lang)}<span class="date-dot">·</span>{event.lunar[lang]}</p></section>
 <section class="container event-detail"><div class="event-detail-main"><div class="event-detail-label">{t.calendar.typeLabels[event.type]}</div><h2>{t.services.specialTitle}</h2><p>{t.calendar.serviceNote}</p><div class="event-time"><Icon name="clock"/><span>{event.serviceTime||pendingTime}</span></div><p>{t.common.mandarin} · {t.common.noRegistration}</p><a class="button primary" href={`mailto:${site.email}?subject=${encodeURIComponent(event.title[lang])}`}>{t.common.email}<Icon name="mail"/></a></div><aside class="event-aside"><h2>{t.home.visitTitle}</h2><p>{site.address}<br/>{site.cityLine}</p><p>{t.common.openDaily}</p><a class="text-link" href={site.mapUrl} target="_blank" rel="noopener noreferrer">{t.common.directions}<Icon name="external"/></a><p>{t.common.freeMeal}</p></aside></section>
</>}
{customEvent && <>
 <section class="container page-heading event-heading"><a class="back-link" href={`${link(lang,'services')}#latest-assemblies`}><Icon name="left"/>{t.updates.backToAssemblies}</a><h1>{customEvent.title[lang]}</h1><p><time datetime={customEvent.date}>{dateText(customEvent.date,lang)}</time></p></section>
 <AnnouncementDetail lang={lang} entry={customEvent} isEvent/>
</>}
{newsItem && <>
 <section class="container page-heading event-heading"><a class="back-link" href={link(lang,'news')}><Icon name="left"/>{t.updates.backToNews}</a><h1>{newsItem.title[lang]}</h1><p><time datetime={newsItem.date}>{dateText(newsItem.date,lang)}</time></p></section>
 <AnnouncementDetail lang={lang} entry={newsItem}/>
</>}
</Layout>
<script>
  import {dateText} from '../../lib/temple.js';
  import {nextSundayDate,onPhillyDateChange} from '../../lib/live-dates.js';
  document.querySelectorAll('[data-next-sunday]').forEach(element => {
    onPhillyDateChange(today => {
      const sunday = nextSundayDate(today);
      element.dateTime = sunday;
      element.textContent = dateText(sunday, element.dataset.lang, {month:'long',day:'numeric'});
    });
  });
</script>
