---
import {copy, todayInPhilly, link} from '../lib/temple.js';
import {activityCalendarView} from '../lib/activity-calendar-view.js';
import regular from '../data/weekly-practice.json';
import Icon from './Icon.astro';
const {lang, events} = Astro.props;
const t = copy[lang].activityCalendar;
const today = todayInPhilly();
const month = today.slice(0, 7);
const view = activityCalendarView(month, events, regular, lang, null, today);
---
<section class="container activity-calendar" id="activity-calendar" aria-labelledby="activity-calendar-title" data-activity-calendar data-lang={lang} data-events={JSON.stringify(events)} data-regular={JSON.stringify(regular)}>
  <div class="activity-intro">
    <div><h2 id="activity-calendar-title">{t.title}</h2><p>{t.intro}</p></div>
    <a class="text-link" href={link(lang, 'calendar')}>{copy[lang].nav.calendar}<Icon/></a>
  </div>
  <div class="activity-toolbar">
    <h3 class="activity-month-title" id="activity-month-title" data-activity-month aria-live="polite">{view.monthLabel}</h3>
    <div class="activity-paging" role="group" aria-label={t.navigation} data-activity-controls hidden>
      <button class="activity-arrow" type="button" data-activity-previous aria-label={copy[lang].calendar.previous}><Icon name="left"/></button>
      <button class="activity-today" type="button" data-activity-today>{t.thisMonth}</button>
      <button class="activity-arrow" type="button" data-activity-next aria-label={copy[lang].calendar.next}><Icon name="right"/></button>
    </div>
  </div>
  <div class="activity-legend"><span class="activity-weekly"><span class="activity-mark" aria-hidden="true"></span>{t.regularLabel}</span><span class="activity-service"><span class="activity-mark" aria-hidden="true"></span>{t.serviceLabel}</span><span class="activity-hint" data-activity-controls hidden>{t.selectDay}</span></div>
  <table class="activity-month-grid" aria-labelledby="activity-calendar-title activity-month-title">
    <thead><tr>{copy[lang].calendar.weekdays.map(day => <th scope="col">{day}</th>)}</tr></thead>
    <tbody data-activity-grid set:html={view.tableRows}/>
  </table>
  <div class="activity-agenda" id="activity-agenda" aria-labelledby="activity-agenda-title">
    <div class="activity-agenda-heading"><h3 id="activity-agenda-title" data-activity-agenda-title aria-live="polite">{view.agendaLabel}</h3><button class="activity-clear" type="button" data-activity-clear hidden>{t.allMonth}</button></div>
    <div data-activity-agenda set:html={view.agenda}/>
  </div>
  <p class="activity-note">{copy[lang].services.noticeText}</p>
  <noscript><p class="activity-note">{t.noScript}</p></noscript>
</section>

<script>
  import {todayInPhilly} from '../lib/temple.js';
  import {onPhillyDateChange} from '../lib/live-dates.js';
  import {isMonthKey, shiftMonth, monthActivities} from '../lib/activity-calendar.js';
  import {activityCalendarView} from '../lib/activity-calendar-view.js';

  document.querySelectorAll('[data-activity-calendar]').forEach(root => {
    const lang = root.dataset.lang;
    const events = JSON.parse(root.dataset.events);
    const regular = JSON.parse(root.dataset.regular);
    let today = todayInPhilly();
    const params = new URLSearchParams(location.search);
    let followCurrentMonth = !isMonthKey(params.get('activity-month'));
    let month = followCurrentMonth ? today.slice(0, 7) : params.get('activity-month');
    let selectedDate = monthActivities(month, events, regular.excludedDates).some(entry => entry.date === params.get('activity-date')) ? params.get('activity-date') : null;
    root.querySelectorAll('[data-activity-controls]').forEach(control => {control.hidden = false;});

    function render(updateUrl = false) {
      const view = activityCalendarView(month, events, regular, lang, selectedDate, today);
      root.querySelector('[data-activity-month]').textContent = view.monthLabel;
      root.querySelector('[data-activity-grid]').innerHTML = view.tableRows;
      root.querySelector('[data-activity-agenda]').innerHTML = view.agenda;
      root.querySelector('[data-activity-agenda-title]').textContent = view.agendaLabel;
      root.querySelector('[data-activity-clear]').hidden = !selectedDate;
      root.querySelector('[data-activity-previous]').disabled = shiftMonth(month, -1) === month;
      root.querySelector('[data-activity-next]').disabled = shiftMonth(month, 1) === month;
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.set('activity-month', month);
        if (selectedDate) url.searchParams.set('activity-date', selectedDate);
        else url.searchParams.delete('activity-date');
        history.replaceState(null, '', url);
      }
    }
    root.querySelector('[data-activity-previous]').addEventListener('click', () => {month = shiftMonth(month, -1); selectedDate = null; followCurrentMonth = false; render(true);});
    root.querySelector('[data-activity-next]').addEventListener('click', () => {month = shiftMonth(month, 1); selectedDate = null; followCurrentMonth = false; render(true);});
    root.querySelector('[data-activity-today]').addEventListener('click', () => {today = todayInPhilly(); month = today.slice(0, 7); selectedDate = null; followCurrentMonth = true; render(true);});
    root.querySelector('[data-activity-clear]').addEventListener('click', () => {selectedDate = null; render(true); root.querySelector('[data-activity-today]').focus({preventScroll:true});});
    root.querySelector('[data-activity-grid]').addEventListener('click', event => {
      const button = event.target.closest('[data-activity-date]');
      if (!button) return;
      selectedDate = button.dataset.activityDate;
      followCurrentMonth = false;
      render(true);
      root.querySelector(`[data-activity-date="${selectedDate}"]`).focus({preventScroll:true});
    });
    onPhillyDateChange(date => {
      today = date;
      if (followCurrentMonth) month = today.slice(0, 7);
      render();
    });
  });
</script>

<style is:global>
  .activity-calendar {padding-bottom:88px;}
  .activity-intro {display:flex;justify-content:space-between;align-items:baseline;gap:32px;margin-bottom:30px;}
  .activity-intro h2 {margin-bottom:14px;}
  .activity-intro p {font-size:17px;color:var(--muted);margin:0;max-width:45em;}
  .activity-intro>.text-link {white-space:nowrap;flex-shrink:0;}
  .activity-toolbar {display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--ink);padding-block:20px 16px;}
  .activity-calendar .activity-month-title {font-size:30px;line-height:1.4;}
  .activity-paging {display:flex;align-items:center;gap:10px;}
  .activity-paging button {min-width:44px;min-height:44px;background:none;border:1px solid var(--line);border-radius:2px;}
  .activity-paging .activity-today {padding-inline:17px;font-size:15px;}
  .activity-paging button:hover {background:var(--soft);border-color:var(--ink);}
  .activity-legend {display:flex;align-items:center;gap:24px;padding-bottom:20px;font-size:14px;color:var(--muted);flex-wrap:wrap;}
  .activity-legend>span,.activity-event-type {display:inline-flex;align-items:center;gap:8px;}
  .activity-hint {margin-left:auto;}
  .activity-mark {display:inline-block;flex-shrink:0;width:7px;height:7px;background:var(--ink);}
  .activity-service .activity-mark {background:var(--red);border-radius:50%;}
  .activity-month-grid {border-collapse:collapse;table-layout:fixed;width:100%;font-variant-numeric:tabular-nums;}
  .activity-month-grid th {padding:10px 4px;background:var(--ink);color:var(--paper);font-size:14px;font-weight:400;text-align:center;border:1px solid var(--ink);}
  .activity-month-grid td {padding:0;vertical-align:top;border:1px solid var(--line);height:104px;}
  .activity-outside {background:#eff0e8;}
  .activity-day-inner {display:block;min-height:104px;width:100%;padding:10px 12px;text-align:left;}
  button.activity-day-inner {height:100%;border:0;background:transparent;border-radius:0;}
  button.activity-day-inner:hover,.activity-selected {background:var(--soft);}
  button.activity-day-inner:focus-visible {outline-offset:-3px;}
  .activity-day-inner>time {display:grid;place-items:center;width:27px;height:27px;font-size:16px;line-height:1;}
  .activity-is-today .activity-day-inner>time {background:var(--red);color:var(--white);border-radius:50%;}
  .activity-selected button {box-shadow:inset 0 0 0 1px var(--ink);}
  .activity-day-items {display:flex;flex-direction:column;gap:6px;margin-top:9px;}
  .activity-grid-event {display:flex;align-items:baseline;gap:6px;}
  .activity-grid-title {font-size:14px;line-height:1.6;overflow-wrap:anywhere;}
  .activity-agenda {margin-top:30px;}
  .activity-agenda-heading {display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding-bottom:15px;border-bottom:1px solid var(--ink);}
  .activity-calendar .activity-agenda-heading h3 {font-size:25px;}
  .activity-clear {background:none;border:0;padding:8px 0;color:var(--red);font-size:15px;text-decoration:underline;text-underline-offset:5px;min-height:44px;}
  .activity-event-list {list-style:none;margin:0;padding:0;}
  .activity-event-row {display:flex;align-items:center;gap:25px;padding-block:20px;border-bottom:1px solid var(--line);}
  .activity-event-date {display:flex;flex-direction:column;align-items:center;min-width:55px;line-height:1.3;}
  .activity-event-date strong {font-family:var(--serif);font-size:32px;font-weight:400;}
  .activity-event-date>span {font-size:12px;color:var(--muted);}
  .activity-event-copy {min-width:0;flex:1;}
  .activity-calendar .activity-event-copy h4 {font-family:var(--serif);font-size:23px;font-weight:500;line-height:1.5;margin:0;overflow-wrap:anywhere;}
  .activity-event-copy p {font-size:15px;color:var(--muted);margin:5px 0 0;}
  .activity-event-type {font-size:13px;color:var(--muted);}
  .activity-event-row>svg {color:var(--red);}
  .activity-event-row:hover h4 {text-decoration:underline;}
  .activity-note {font-size:14px;color:var(--muted);margin:22px 0 0;max-width:75ch;}
  .activity-empty {font-size:16px;color:var(--muted);margin:24px 0;}
  @media(max-width:1000px) {
    .activity-intro {display:block;}
    .activity-intro>.text-link {margin-top:20px;}
    .activity-day-inner {padding:8px;}
    .activity-grid-title {font-size:12px;}
  }
  @media(max-width:700px) {
    .activity-calendar {padding-bottom:56px;}
    .activity-intro {margin-bottom:25px;}
    .activity-intro p {font-size:16px;}
    .activity-calendar .activity-month-title {font-size:24px;}
    .activity-toolbar {gap:10px;flex-wrap:wrap;}
    .activity-paging {gap:5px;margin-left:auto;}
    .activity-paging .activity-today {font-size:13px;padding-inline:10px;}
    .activity-legend {gap:12px 20px;font-size:12px;padding-bottom:15px;}
    .activity-hint {margin-left:0;flex-basis:100%;}
    .activity-month-grid th {font-size:12px;}
    .activity-month-grid td {height:64px;}
    .activity-day-inner {padding:6px 3px;min-height:64px;text-align:center;}
    .activity-day-inner>time {font-size:15px;margin-inline:auto;}
    .activity-grid-title {display:none;}
    .activity-day-items {flex-direction:row;justify-content:center;flex-wrap:wrap;gap:5px;margin-top:7px;}
    .activity-grid-event {display:inline-flex;}
    .activity-agenda {margin-top:25px;}
    .activity-agenda-heading {flex-wrap:wrap;gap:6px;}
    .activity-calendar .activity-agenda-heading h3 {font-size:23px;}
    .activity-clear {font-size:14px;}
    .activity-event-row {gap:15px;padding-block:18px;}
    .activity-event-date {min-width:42px;}
    .activity-event-date strong {font-size:30px;}
    .activity-calendar .activity-event-copy h4 {font-size:22px;}
    .activity-event-copy p {font-size:13px;}
    .activity-event-type {display:none;}
    .activity-note {font-size:13px;}
  }
</style>
