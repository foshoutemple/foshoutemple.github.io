  external:'M8 5H5v14h14v-3M13 5h6v6M19 5 10 14',
  pin:'M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0ZM12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  clock:'M12 7v5l3 2M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z',
  mail:'M3 5h18v14H3ZM3 6l9 7 9-7',
  calendar:'M5 3v4M19 3v4M3 10h18M3 5h18v16H3Z',
  globe:'M21 12H3M12 3c5 5 5 13 0 18-5-5-5-13 0-18ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  chevron:'m8 10 4 4 4-4',
  menu:'M4 7h16M4 12h16M4 17h16',
  plus:'M5 12h14M12 5v14',
