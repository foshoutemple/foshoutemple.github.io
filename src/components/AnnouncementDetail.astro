---
import {asset, copy, link, site} from '../lib/temple.js';
import {announcementImageSource} from '../lib/event-content.js';
import Icon from './Icon.astro';
const {lang, entry, isEvent = false, dedication} = Astro.props;
const t = copy[lang];
const imageSrc = announcementImageSource(entry.image, lang);
const registration = isEvent ? entry.registration?.[lang] : null;
---
<section class:list={['container', 'announcement-detail', {'has-image': entry.image}]}>
  {entry.image && <figure class="announcement-image">
    <a href={asset(imageSrc)} target="_blank" rel="noopener noreferrer">
      <img src={asset(imageSrc)} width={entry.image.width} height={entry.image.height} alt={entry.image.alt[lang]} decoding="async"/>
      <span class="image-action">{t.updates.viewImage}<Icon name="external" size={16}/></span>
    </a>
  </figure>}
  <div class="prose">
    <p class="large-copy">{entry.description[lang]}</p>
    {isEvent && <p>{registration ? t.services.eventLanguage : t.services.eventAttendance}{' '}{t.services.afterPracticeMeal}</p>}
    {dedication && <section class="notice-section">
      <h2>{t.updates.dedicationTitle}</h2>
      <p>{dedication}</p>
    </section>}
    {registration && <section class="notice-section">
      <h2>{t.updates.registrationTitle}</h2>
      <p>{registration}</p>
      <a class="text-link" href={`mailto:${site.email}?subject=${encodeURIComponent(entry.title[lang])}`}>{t.common.email}<Icon name="mail" size={16}/></a>
    </section>}
    {isEvent && <a class="button primary" href={link(lang,'visit')}>{t.nav.visit}<Icon/></a>}
    <slot/>
  </div>
</section>
<style>
  .announcement-detail {padding-bottom:90px;}
  .announcement-detail.has-image {display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:72px;align-items:start;}
  .announcement-image {margin:0;max-width:560px;}
  .announcement-image img {width:100%;height:auto;}
  .image-action {display:flex;align-items:center;gap:10px;margin-top:14px;font-size:15px;color:var(--red);}
  .announcement-image a:hover .image-action {text-decoration:underline;}
  .prose {max-width:65ch;min-width:0;}
  .prose .large-copy {margin-top:0;}
  .notice-section {margin-block:28px;border-top:1px solid var(--line);padding-top:20px;}
  .notice-section h2 {font-size:24px;margin:0;}
  .notice-section p {margin:8px 0 0;}
  .notice-section .text-link {margin-top:12px;}
  @media(max-width:1000px) {.announcement-detail.has-image {gap:36px;}}
  @media(max-width:700px) {
    .announcement-detail {padding-bottom:50px;}
    .announcement-detail.has-image {grid-template-columns:1fr;gap:30px;}
  }
</style>
